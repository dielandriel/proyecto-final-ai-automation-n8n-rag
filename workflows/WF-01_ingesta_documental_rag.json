    {
      "parameters": {
        "jsCode": "const existentes = new Set();\nfor (const fila of $input.all()) {\n  let metadata = fila.json.metadata;\n  if (typeof metadata === 'string') {\n    try { metadata = JSON.parse(metadata); } catch (e) { metadata = {}; }\n  }\n  if (metadata && metadata.procedimiento) existentes.add(metadata.procedimiento);\n}\nconst documentos = $('Leer archivos y metadatos').all().filter((d) => d.json.valido);\nreturn documentos.map((d) => {\n  const yaCargado = existentes.has(d.json.procedimiento);\n  return {\n    json: {\n      ...d.json,\n      ya_cargado: yaCargado,\n      motivo: yaCargado\n        ? 'El procedimiento ' + d.json.procedimiento + ' ya está cargado en la base documental. No se modificó. La actualización de versiones requiere un procedimiento de migración posterior.'\n        : '',\n    },\n  };\n});"
      },
