      "id": "5b6a8865-d1a1-4828-afbb-4557c4badc02",
      "name": "Documento válido",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        448,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const documentos = $input.all();\nconst salida = [];\nfor (const doc of documentos) {\n  const { texto, procedimiento, version, archivo_origen, titulo } = doc.json;\n  const partes = texto.split(/\\n(?=## )/);\n  let orden = 0;\n  for (const parte of partes) {\n    const cuerpo = parte.trim();\n    if (!cuerpo) continue;\n    const encabezado = cuerpo.match(/^## (\\d+)\\. (.+)/);\n    salida.push({\n      json: {\n        procedimiento,\n        version,\n        archivo_origen,\n        titulo,\n        tipo_documento: 'procedimiento',\n        seccion_numero: encabezado ? encabezado[1] : '0',\n        seccion_titulo: encabezado ? encabezado[2].trim() : 'Encabezado y aviso',\n        orden: String(orden),\n        texto: cuerpo,\n      },\n    });\n    orden++;\n  }\n}\nreturn salida;"
      },
