    {
      "parameters": {
        "jsCode": "const porProcedimiento = {};\nfor (const item of $input.all()) {\n  const clave = (item.json.metadata || {}).procedimiento || 'SIN_IDENTIFICAR';\n  porProcedimiento[clave] = (porProcedimiento[clave] || 0) + 1;\n}\nconst documentos = $('Leer archivos y metadatos').all().map((d) => ({\n  archivo_origen: d.json.archivo_origen,\n  procedimiento: d.json.procedimiento,\n  version: d.json.version,\n  valido: d.json.valido,\n  motivo: d.json.motivo,\n}));\nreturn [{ json: { documentos_recibidos: documentos.length, documentos_validos: documentos.filter((d) => d.valido).length, fragmentos_insertados: $input.all().length, fragmentos_por_procedimiento: porProcedimiento, documentos } }];"
      },
