      "parameters": {
        "authentication": "n8nUserAuth",
        "formTitle": "Ingesta documental RAG",
        "formDescription": "Cargá uno o más procedimientos en formato Markdown. Solo se aceptan procedimientos que todavía no estén cargados; los ya existentes se rechazan sin modificarlos.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Procedimientos",
              "fieldType": "file",
              "fieldName": "procedimientos",
              "acceptFileTypes": ".md",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Cargar",
          "path": "ingesta-documental-rag",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Carga procesada. Revisá el resultado en la ejecución del workflow."
            }
          }
        }
      },
      "id": "966146b4-6be4-4d24-b4cd-d2f08637df74",
      "name": "Formulario de carga",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        304
      ],
      "webhookId": "ae3c2a08-b647-4c43-9e7b-77a1205766f4"
    },
    {
      "parameters": {
        "jsCode": "const salida = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const binarios = items[i].binary || {};\n  for (const clave of Object.keys(binarios)) {\n    const buffer = await this.helpers.getBinaryDataBuffer(i, clave);\n    const texto = buffer.toString('utf8').replace(/^\\uFEFF/, '').replace(/\\r\\n/g, '\\n');\n    const archivo = binarios[clave].fileName || clave;\n    const procedimiento = (texto.match(/\\*\\*Identificador:\\*\\*\\s*(PRO-[A-Z]{2}-\\d{3})/) || [])[1] || '';\n    const version = (texto.match(/\\*\\*Versión:\\*\\*\\s*(\\d+(?:\\.\\d+)*)/) || [])[1] || '';\n    const titulo = ((texto.match(/\\*\\*Título:\\*\\*\\s*(.+)/) || [])[1] || '').trim();\n    let motivo = '';\n    if (!archivo.toLowerCase().endsWith('.md')) motivo = 'El archivo no es Markdown';\n    else if (!procedimiento) motivo = 'No se encontró el identificador del procedimiento';\n    else if (!version) motivo = 'No se encontró la versión del procedimiento';\n    salida.push({ json: { archivo_origen: archivo, procedimiento, version, titulo, caracteres: texto.length, valido: motivo === '', motivo, texto } });\n  }\n}\nif (salida.length === 0) {\n  throw new Error('No se recibió ningún archivo.');\n}\nconst vistos = new Set();\nfor (const doc of salida) {\n  if (!doc.json.valido) continue;\n  if (vistos.has(doc.json.procedimiento)) {\n    doc.json.valido = false;\n    doc.json.motivo = 'Procedimiento repetido en la misma carga';\n  }\n  vistos.add(doc.json.procedimiento);\n}\nreturn salida;"
      },
